# Salin menjadi .env lalu sesuaikan. scripts\windows\setup.ps1 membuat berkas ini otomatis.

# Server web: dengarkan semua antarmuka, port 18085
DCC_HOST=0.0.0.0
DCC_PORT=18085

# Hanya jaringan ini yang boleh membuka aplikasi (pisahkan dengan koma).
DCC_ALLOWED_NETWORKS=10.17.119.0/24,127.0.0.1/32,::1/128

# Database PostgreSQL (instance yang sama dengan event downloader, database terpisah)
DCC_DATABASE_URL=host=127.0.0.1 port=5432 dbname=disaster_center user=dcc_app password=GANTI_KATA_SANDI

# Kunci rahasia sesi (acak, 64 karakter hex). Kosongkan = dibuat otomatis di data\.secret_key
DCC_SECRET_KEY=

# Akun admin pertama (dibuat sekali bila belum ada admin). Wajib diganti saat login pertama.
DCC_INITIAL_ADMIN_USER=admin
DCC_INITIAL_ADMIN_PASSWORD=

# Folder data (foto kejadian, impor). Default: .\data
DCC_DATA_DIR=

# Collector BMKG
DCC_COLLECTOR_ENABLED=true
DCC_BMKG_INTERVAL=60

# Batas unggahan
DCC_MAX_PHOTO_MB=10
DCC_MAX_IMPORT_MB=150
DCC_SESSION_HOURS=12

# Isi true hanya bila aplikasi dipasang di belakang reverse proxy (IIS/nginx)
DCC_TRUST_PROXY_HEADERS=false
DCC_COOKIE_SECURE=false
